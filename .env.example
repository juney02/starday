# ============================================================
# 별하루 환경변수 목록 (.env.example)
#
# Google Apps Script에는 .env 파일이 없습니다. 대신 아래 이름·값을
# Apps Script 편집기 > 왼쪽 톱니바퀴(프로젝트 설정) > "스크립트 속성" 에 직접 추가하세요.
# 이 파일은 "어떤 이름을 넣어야 하는지" 알려주는 견본이며, 실제 비밀 값은 절대 여기나 코드에 쓰지 마세요.
# ============================================================

# ---- 동작 모드 -------------------------------------------------
# TEST(기본): X API 없이 가상 게시물로 전체 흐름을 시험. 화면에 "테스트 운세"가 항상 표시됨
# PRODUCTION: 공식 X API로 @Hi_Ohaasa 게시물을 조회 (아래 X_BEARER_TOKEN과 이용 허락 필요)
MODE=TEST

# ---- 비밀 값 (없으면 해당 기능만 꺼집니다) ----------------------
# X 개발자 포털에서 발급한 Bearer Token. 없으면 운영 모드 수집이 실패로 기록됩니다.
X_BEARER_TOKEN=
# 일본어→한국어 번역과 이미지 분석에 쓰는 Claude API 키 (없으면 번역을 하지 않음)
ANTHROPIC_API_KEY=
# 관리자 화면 로그인 토큰. 편집기에서 setupAdminToken 함수를 실행하면 자동으로 만들어집니다.
ADMIN_TOKEN=
# (선택) 토큰 없이 구글 계정으로 관리자 인증을 허용할 이메일, 쉼표로 구분. 일반 구글 계정은 방문자 이메일 확인이 안 될 수 있어 토큰 방식을 권장
ADMIN_EMAILS=

# ---- 선택 설정 (관리자 화면의 "설정" 탭에서도 바꿀 수 있음) -----
# true면 검증을 통과한 데이터를 관리자 승인 없이 바로 공개 (기본 false = 승인 후 공개)
AUTO_PUBLISH=false
# false로 하면 한국어 번역이 없어도 공개 가능 (기본 true)
PUBLISH_REQUIRES_TRANSLATION=true
# 운세 보관·표시 기간(일). 0이면 제한 없음 (기본 30)
RETENTION_DAYS=30
# TEST 모드에서 저장된 데이터가 없을 때 즉석 가상 운세를 보여줄지 (기본 true)
TEST_FALLBACK=true
# TEST 모드 시나리오: normal | none | duplicate_rank | missing_sign | wrong_date | image_only
TEST_SCENARIO=normal
# true일 때만 이미지 게시물 분석 사용 (기본 false)
OCR_ENABLED=false
# 번역·이미지 분석에 쓸 Claude 모델 (기본 claude-sonnet-5-5)
TRANSLATE_MODEL=claude-sonnet-5-5

# ---- AI 도우미 (Gemini) ----------------------------------------
# Google AI Studio(aistudio.google.com)에서 발급한 Gemini API 키. 없으면 AI 도우미 탭에 "아직 준비되지 않았어요"가 보입니다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름 (기본 gemini-3.1-flash-lite). 안 되면 편집기에서 listGeminiModels 함수를 실행해 쓸 수 있는 이름을 확인하세요.
GEMINI_MODEL=gemini-3.1-flash-lite
# AI 도우미 하루 사용 한도(회, 전체 합계). 비용 보호용이며 기본 50
AI_DAILY_LIMIT=50
# false로 하면 AI 도우미를 끕니다 (기본 true)
AI_ENABLED=true
